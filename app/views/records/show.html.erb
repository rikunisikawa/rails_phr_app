<h1 class="mb-4">記録</h1>

<div class="card mb-4">
  <div class="card-body">
    <p class="card-text">
      <strong>日付:</strong>
      <%= @record.date %>
    </p>

    <p class="card-text">
      <strong>健康スコア:</strong>
      <%= @record.health_score %>
    </p>

    <p class="card-text">
      <strong>気分スコア:</strong>
      <%= @record.mood_score %>
    </p>

    <p class="card-text">
      <strong>メモ:</strong>
      <%= @record.memo %>
    </p>
  </div>
</div>

<div class="d-flex justify-content-between">
  <%= link_to '編集', edit_record_path(@record), class: 'btn btn-primary' %>
  <%= link_to '戻る', records_path, class: 'btn btn-secondary' %>
</div>