<style>
  .overlay-marker {
    width: 20px;
    height: 20px;
    position: absolute;
  }
  .chartWithMarkerOverlay {
    position: relative;
    width: 100%;
  }
  .modal {
    display: none;
    position: fixed;
    z-index: 1;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgb(0,0,0);
    background-color: rgba(0,0,0,0.4);
  }
  .modal-content {
    background-color: #fefefe;
    margin: 15% auto;
    padding: 20px;
    border: 1px solid #888;
    width: 80%;
  }
  .close {
    color: #aaa;
    float: right;
    font-size: 28px;
    font-weight: bold;
  }
  .close:hover,
  .close:focus {
    color: black;
    text-decoration: none;
    cursor: pointer;
  }
</style>
<!-- 画面の右上に円の＋アイコンで「気分の記録」ボタンを追加 -->
<div style="position: fixed; top: 20px; right: 20px;">
  <button id="newRecordBtn" class="btn btn-primary rounded-circle" style="width: 50px; height: 50px; padding: 0;">
    <i class="material-icons">add</i>
  </button>
</div>
<div class="container-fluid mt-4">
  <div class="d-flex align-items-center">
    <%= render 'shared/date_navigation', selected_date: @selected_date %>

  </div>
  <div class="row">
    <div class="col-md-12 chartWithMarkerOverlay">
      <div id="chart_div" style="width: 100%; height: 500px;"></div>
    </div>
  </div>

  <div class="table-responsive mt-4">
    <table class="table table-striped table-hover-column" style="border-collapse: collapse;">
      <thead class="thead-dark">
        <tr>
          <th style="border: 1px solid #ddd;">項目</th>
          <% (@selected_date.beginning_of_month..@selected_date.end_of_month).each do |date| %>
            <th class="highlighted-date" style="border: 1px solid #ddd;" data-date="<%= date.strftime('%Y-%m-%d') %>"><%= date.strftime("%-d") %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">健康スコア</td>
          <% (@selected_date.beginning_of_month..@selected_date.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.health_score %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">気分スコア</td>
          <% (@selected_date.beginning_of_month..@selected_date.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.mood_score %>
            </td>
          <% end %>
        </tr>
      </tbody>
    </table>
  </div>

  <%= link_to '気分の記録', new_record_path, class: 'btn btn-success mt-3' %>
</div>



<% if @show_popup %>
  <div id="myModal" class="modal">
    <div class="modal-content">
      <span class="close">&times;</span>
      <h2>今どんな感じ？</h2>
      <%= render 'form', record: Record.new(date: Date.today) %>
    </div>
  </div>
<% end %>

<script type="text/javascript">
  google.charts.load('current', {'packages':['corechart']});
  google.charts.setOnLoadCallback(drawChart);

  function drawChart() {
    var data = google.visualization.arrayToDataTable([
      ['日付', '健康スコア', '気分スコア', '筋トレ', 'ランニング', 'ストレッチ'],
      <% @health_scores.each do |date, health_score| %>
        ['<%= date.strftime("%-m/%-d") %>', <%= health_score.nil? ? 'null' : health_score.to_f %>, <%= @mood_scores[date].nil? ? 'null' : @mood_scores[date].to_f %>, <%= @muscle_training_data[date].nil? ? 'null' : @muscle_training_data[date].to_f %>, <%= @running_data[date].nil? ? 'null' : @running_data[date].to_f %>, <%= @stretching_data[date].nil? ? 'null' : @stretching_data[date].to_f %>],
      <% end %>
    ]);

    console.log(data.toJSON()); // データをコンソールに出力

    var options = {
      title: '1カ月分の記録',
      curveType: 'none', // 直線
      legend: { position: 'bottom' },
      series: {
        0: { type: 'line', pointSize: 5, lineDashStyle: [2, 2] }, // 健康スコア
        1: { type: 'line', pointSize: 5, lineDashStyle: [2, 2] }, // 気分スコア
        2: { type: 'scatter', pointSize: 0, visibleInLegend: false }, // 筋トレ
        3: { type: 'scatter', pointSize: 0, visibleInLegend: false }, // ランニング
        4: { type: 'scatter', pointSize: 0, visibleInLegend: false }  // ストレッチ
      },
      hAxis: {
      format: 'M/d',
      gridlines: { color: '#ccc', count: -1 }, // 縦の罫線を追加
      ticks: data.getDistinctValues(0).filter((_, i) => i % 5 === 0)
      },
      vAxis: {
      viewWindow: {
        min: 0,
        max: 100
      }
      }
    };

    var chart = new google.visualization.ComboChart(document.getElementById('chart_div'));

    google.visualization.events.addListener(chart, 'ready', placeMarkers.bind(chart, data));
    chart.draw(data, options);
  }

  function placeMarkers(dataTable) {
    var cli = this.getChartLayoutInterface();
    var chartArea = cli.getChartAreaBoundingBox();

    // 既存のマーカーを削除
    document.querySelectorAll('.overlay-marker').forEach(marker => marker.remove());

    // 0から30までのポイントに対してマーカーを配置
    for(var i = 3; i <= 5; i++) {
      for(var j = 0; j < dataTable.getNumberOfRows(); j++) {
        if (dataTable.getValue(j, i) !== null) {
          var marker = document.createElement('div');
          marker.className = 'overlay-marker';
          marker.style.top = Math.floor(cli.getYLocation(dataTable.getValue(j, i))) - 10 + "px";
          marker.style.left = Math.floor(cli.getXLocation(j)) + "px";
          if (i == 3) {
            marker.innerHTML = '<img src="/assets/exercise.png" height="30" width="30">';
          } else if (i == 4) {
            marker.innerHTML = '<img src="/assets/running.png" height="30" width="30">';
          } else if (i == 5) {
            marker.innerHTML = '<img src="/assets/physical_therapy.png" height="30" width="30">';
          }
          document.querySelector('.chartWithMarkerOverlay').appendChild(marker);
        }
      }
    }
  }

  // ポップアップの表示
  document.addEventListener('DOMContentLoaded', function() {
    var modal = document.getElementById("myModal");
    var span = document.getElementsByClassName("close")[0];
    var newRecordBtn = document.getElementById("newRecordBtn");

    if (modal) {
      if (<%= @show_popup %>) {
        modal.style.display = "block";
      }

      span.onclick = function() {
        modal.style.display = "none";
      }

      window.onclick = function(event) {
        if (event.target == modal) {
          modal.style.display = "none";
        }
      }

      newRecordBtn.onclick = function() {
        modal.style.display = "block";
      }
    }
  });
</script>