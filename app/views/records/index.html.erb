<style>
.material-symbols-outlined {
  font-variation-settings:
  'FILL' 0,
  'wght' 400,
  'GRAD' 0,
  'opsz' 24
}
</style>

<div class="container-fluid mt-4">
  <h2><%= Date.today.strftime("%Y年%m月") %></h2>
  <div class="row">
    <div class="col-md-12 d-flex justify-content-end">
      <div class="form-check form-check-inline">
        <input class="form-check-input" type="checkbox" id="healthScoreCheckbox" checked>
        <label class="form-check-label" for="healthScoreCheckbox">健康スコア</label>
      </div>
      <div class="form-check form-check-inline">
        <input class="form-check-input" type="checkbox" id="moodScoreCheckbox" checked>
        <label class="form-check-label" for="moodScoreCheckbox">気分スコア</label>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col-md-12">
      <%= line_chart [
        { name: "健康スコア", data: @health_scores },
        { name: "気分スコア", data: @mood_scores }
        ], xtitle: "日付", ytitle: "スコア", library: { 
          xAxis: { labels: { formatter: raw("function() { return Highcharts.dateFormat('%m/%d', this.value); }") } },
          lineWidth: 0, 
          marker: { enabled: false } 
        }, "data-turbo": "false", id: "combinedChart" %>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-striped table-hover-column" style="border-collapse: collapse;">
      <thead class="thead-dark">
      <tr>
        <th style="border: 1px solid #ddd;">項目</th>
        <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
        <th class="highlighted-date" style="border: 1px solid #ddd;" data-date="<%= date.strftime('%Y-%m-%d') %>">
            <%= date.strftime("%-d") %><br><%= %w(日 月 火 水 木 金 土)[date.wday] %>
        </th>
        <% end %>
      </tr>
      </thead>

      <tbody>
      <tr>
        <td style="width: 150px; border: 1px solid #ddd;">健康スコア</td>
        <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
        <% record = @records.find { |r| r.date == date } %>
        <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
          <%= record&.health_score %>
        </td>
        <% end %>
      </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">気分スコア</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.mood_score %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">運動の種類</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.exercise_type %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">運動時間 (分)</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.exercise_duration %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">瞑想時間 (分)</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.meditation_duration %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">睡眠時間 (時間)</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.sleep_duration %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">ストレスレベル</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.stress_level %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">体重 (kg)</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.weight %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">体温 (℃)</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.temperature %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">集中力</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.concentration %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">疲労感</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.fatigue %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">メモ</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <% if record&.memo.present? %>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-text" viewBox="0 0 16 16">
                  <path d="M5 4a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1zm-.5 2.5A.5.5 0 0 1 5 6h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5M5 8a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1zm0 2a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1z"/>
                  <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2zm10-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1"/>
                </svg>
              <% else %>
                &nbsp;
              <% end %>
            </td>
          <% end %>
        </tr>
      </tbody>
    </table>
  </div>

  <%= link_to '登録 / 編集', new_record_path, class: 'btn btn-success mt-3' %>
</div>