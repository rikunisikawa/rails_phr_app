<div class="container-fluid mt-4">
  <h2><%= Date.today.strftime("%Y年%m月") %></h2>
  <div class="row">
    <div class="col-md-12">
      <%= line_chart @health_scores, xtitle: "日付", ytitle: "健康スコア", library: { series: [{ fillColor: 'rgba(0, 0, 255, 0.3)', lineWidth: 0, marker: { enabled: false } }] }, "data-turbo": "false" %>
    </div>
  </div>
  <div class="table-responsive">
    <table class="table table-striped table-hover-column" style="border-collapse: collapse;">
      <thead class="thead-dark">
        <tr>
          <th style="border: 1px solid #ddd;">項目</th>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <th class="highlighted-date" style="border: 1px solid #ddd;" data-date="<%= date.strftime('%Y-%m-%d') %>"><%= date.strftime("%-d") %></th>
          <% end %>
        </tr>
      </thead>

      <tbody>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">健康スコア</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.health_score %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">気分スコア</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.mood_score %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">運動の種類</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.exercise_type %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">運動時間 (分)</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.exercise_duration %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">瞑想時間 (分)</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.meditation_duration %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">睡眠時間 (時間)</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.sleep_duration %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">ストレスレベル</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.stress_level %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">体重 (kg)</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.weight %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">体温 (℃)</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.temperature %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">集中力</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.concentration %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">疲労感</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.fatigue %>
            </td>
          <% end %>
        </tr>
        <tr>
          <td style="width: 150px; border: 1px solid #ddd;">メモ</td>
          <% (Date.today.beginning_of_month..Date.today.end_of_month).each do |date| %>
            <% record = @records.find { |r| r.date == date } %>
            <td style="border: 1px solid #ddd;" data-record-id="<%= record&.id %>">
              <%= record&.memo %>
            </td>
          <% end %>
        </tr>
      </tbody>
    </table>
  </div>

  <%= link_to '登録 / 編集', new_record_path, class: 'btn btn-success mt-3' %>
</div>

